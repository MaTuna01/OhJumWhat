# 이 파일을 복사해 .env로 저장하고 값을 채운다. .env는 git에 올리지 않는다.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ohjumwhat
DB_USERNAME=ohjumwhat
DB_PASSWORD=change-me

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 관리자 계정 이메일(쉼표로 여러 개). 이 구글 계정이 관리자 콘솔(/admin)을 쓸 수 있다.
ADMIN_EMAILS=

# 지도(비우면 지도·근처 식당 찾기를 끄고 링크 방식만 쓴다)
# 카카오 로컬 REST API 키(https://developers.kakao.com → 앱 → 「카카오맵」 활성화). 서버에서만 쓴다.
KAKAO_REST_KEY=
# 네이버 지도 NCP Maps Client ID(https://console.ncloud.com → Maps → Application, 웹 서비스 URL에 도메인 등록)
NAVER_MAP_KEY_ID=

# 웹 푸시(FCM, 새 방명록·쪽지 알림). 비우면 알림 설정을 숨기고 푸시를 끈다.
# Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹 앱)의 공개 값
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
# 클라우드 메시징 → 웹 구성 → 웹 푸시 인증서(VAPID)의 공개 키
FIREBASE_VAPID_KEY=
# 비밀 값. 서비스 계정 JSON(「Firebase Cloud Messaging API 관리자」 역할)을 base64 한 줄로: base64 -i key.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# 운영 배포용
APP_DOMAIN=ohjumwhat.example.com
APP_IMAGE=ghcr.io/matuna01/ohjumwhat:latest
