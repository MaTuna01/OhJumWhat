# 운영 서버의 ~/ohjumwhat/.env 로 복사해 값을 채운다. git에 올리지 않는다.
# docker compose(env_file)가 읽는 형식이다. 셸 스크립트로 source하지 않는다.
# - 목록 값은 쉼표로만 구분하고 띄어 쓰지 않는다(a@gmail.com,b@gmail.com).
# - 공백이 들어간 값은 따옴표로 감싼다. $가 들어간 값은 작은따옴표로 감싼다(따옴표가 없거나 큰따옴표면 compose가 $를 변수로 바꾼다).

# PostgreSQL (컨테이너 안에서만 쓰인다. 비밀번호는 길고 무작위로: openssl rand -hex 24)
DB_NAME=ohjumwhat
DB_USERNAME=ohjumwhat
DB_PASSWORD=

# Google OAuth (운영 리디렉션 URI: https://<APP_DOMAIN>/login/oauth2/code/google 를 콘솔에 등록)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 관리자 계정 이메일(쉼표로 여러 개, 띄어 쓰지 않는다). 이 구글 계정이 관리자 콘솔(/admin)을 쓸 수 있다.
ADMIN_EMAILS=

# 지도(비우면 지도·근처 식당 찾기를 끄고 링크 방식만 쓴다)
# 카카오 로컬 REST API 키(https://developers.kakao.com → 앱 → 「카카오맵」 활성화). 서버에서만 쓴다.
KAKAO_REST_KEY=
# 네이버 지도 NCP Maps Client ID(https://console.ncloud.com → Maps → Application, 웹 서비스 URL에 도메인 등록)
NAVER_MAP_KEY_ID=

# 도메인과 이미지
APP_DOMAIN=www.ohjumwhat.cloud
APP_APEX_DOMAIN=ohjumwhat.cloud
APP_IMAGE=ghcr.io/matuna01/ohjumwhat:latest
