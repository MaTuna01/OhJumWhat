# 로컬 복제 스택용 .env. loadtest/.env.local 로 복사해 쓴다(gitignore). deploy/.env.example 과 같은 키에 로컬 값이다.
# 시드 세션은 구글 OAuth를 거치지 않으므로 구글 키는 더미여도 된다(비우면 Spring이 뜨지 않는다).
DB_NAME=ohjumwhat
DB_USERNAME=ohjumwhat
DB_PASSWORD=loadtest-local-password
GOOGLE_CLIENT_ID=loadtest
GOOGLE_CLIENT_SECRET=loadtest
ADMIN_EMAILS=
KAKAO_REST_KEY=
NAVER_MAP_KEY_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Caddy는 localhost에 내부 CA 인증서를 발급한다(k6는 insecureSkipTLSVerify). 루트 도메인 블록은 다른 이름으로 둔다.
APP_DOMAIN=localhost
APP_APEX_DOMAIN=apex.localhost
# stack.sh build 가 만드는 로컬 이미지
APP_IMAGE=ohjumwhat:loadtest

# 운영 서버 사양(nproc, free -h)에 맞춰 적는다
LOADTEST_APP_CPUS=2
LOADTEST_APP_MEM=4g
LOADTEST_DB_CPUS=2
LOADTEST_DB_MEM=1g
